{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["vite.config.ts", "vitest.config.ts", "eslint.config.mjs", "scripts/**/*"],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
